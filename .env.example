FOUNDRY_PROJECT_ENDPOINT=https://clarion2049-resource.services.ai.azure.com/api/projects/clarionagentic-dev
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5-mini
AGENT_NAME=clarion-m365-rag
LOG_LEVEL=INFO

# Microsoft Graph / Microsoft 365 settings
M365_USER_ID=<user-id-or-upn>
M365_DRIVE_ID=
M365_DRIVE_PATH=
M365_TEAMS_CHANNELS=[{"team_id":"<team-id>","channel_id":"<channel-id>","label":"General"}]
M365_MAX_ITEMS=25

# Partner onboarding auth URL builder settings
PARTNER_AUTH_TENANT=common
PARTNER_AUTH_CLIENT_ID=<partner-app-client-id>
PARTNER_AUTH_REDIRECT_URI=http://127.0.0.1:8787/callback
PARTNER_AUTH_RESPONSE_TYPE=token
PARTNER_AUTH_SCOPES=openid profile offline_access User.Read.All Files.Read.All Mail.Read Calendars.Read ChannelMessage.Read.All

# Optional: service principal environment variables for DefaultAzureCredential
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
AZURE_CLIENT_SECRET=<client-secret>

# Optional profile for future production split
FOUNDRY_PROJECT_ENDPOINT_PROD=https://clarion2049-resource.services.ai.azure.com/api/projects/clarionagentic-prod
