{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Clarion Hosted Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "AgentDev: Clarion Hosted Agent",
      "type": "debugpy",
      "request": "launch",
      "module": "agentdev",
      "args": [
        "run",
        "${workspaceFolder}/main.py",
        "--port",
        "8088"
      ],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    }
  ]
}
